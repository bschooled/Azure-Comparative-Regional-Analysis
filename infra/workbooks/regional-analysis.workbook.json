{
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Regional Analysis\nThis workbook surfaces the latest persisted comparison snapshot produced by the optional Azure-hosted refresh pipeline."
      },
      "name": "intro"
    },
    {
      "type": 1,
      "content": {
        "json": "This workbook uses the Azure Monitor `Custom Endpoint` data source against the hosted Function App. The endpoint host must be added to the workbook trusted-host list the first time the workbook is opened. The workbook does not embed secrets because workbook users can inspect custom-endpoint settings.",
        "style": "info"
      },
      "name": "notes"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "source-region",
            "version": "KqlParameterItem/1.0",
            "name": "SourceRegion",
            "label": "Source Region",
            "type": 1,
            "isRequired": false,
            "value": "eastus"
          },
          {
            "id": "target-region",
            "version": "KqlParameterItem/1.0",
            "name": "TargetRegion",
            "label": "Target Region",
            "type": 1,
            "isRequired": false,
            "value": "westus2"
          },
          {
            "id": "service-family",
            "version": "KqlParameterItem/1.0",
            "name": "ServiceFamily",
            "label": "Service Family",
            "type": 1,
            "isRequired": false,
            "value": "all"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "filters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"CustomEndpoint/1.0\",\"method\":\"GET\",\"url\":\"__FUNCTION_APP_BASE_URL__/api/comparisons\",\"headers\":[],\"urlParams\":[{\"key\":\"sourceRegion\",\"value\":\"{SourceRegion}\"},{\"key\":\"targetRegion\",\"value\":\"{TargetRegion}\"},{\"key\":\"serviceFamily\",\"value\":\"{ServiceFamily}\"}],\"body\":null,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.items[*]\",\"columns\":[]}}]}",
        "size": 0,
        "title": "Current Comparison Projection",
        "queryType": 12,
        "resourceType": "microsoft.resourcegraph/resources",
        "visualization": "table",
        "gridSettings": {
          "filter": true
        }
      },
      "name": "projection"
    },
    {
      "type": 1,
      "content": {
        "json": "The Function endpoint remains public so workbook queries can load in the Azure portal, while the Function runtime storage account stays private behind VNet integration and storage private endpoints. The manual refresh endpoint stays key-protected; only the read-only comparisons endpoint is anonymous.",
        "style": "upsell"
      },
      "name": "next-step"
    }
  ],
  "fallbackResourceIds": [
    "__FUNCTION_APP_RESOURCE_ID__"
  ]
}